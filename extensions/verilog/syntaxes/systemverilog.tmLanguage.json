{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "SystemVerilog",
	"scopeName": "source.systemverilog",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#compiler-directives" },
		{ "include": "#system-tasks" },
		{ "include": "#numbers" },
		{ "include": "#operators" },
		{ "include": "#module-declaration" },
		{ "include": "#class-declaration" },
		{ "include": "#sv-keywords" },
		{ "include": "#keywords" },
		{ "include": "#sv-storage-types" },
		{ "include": "#storage-types" },
		{ "include": "#port-directions" },
		{ "include": "#assertions" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{ "name": "comment.line.double-slash.systemverilog", "match": "//.*$" },
				{ "name": "comment.block.systemverilog", "begin": "/\\*", "end": "\\*/" }
			]
		},
		"strings": {
			"patterns": [
				{ "name": "string.quoted.double.systemverilog", "begin": "\"", "end": "\"", "patterns": [
					{ "name": "constant.character.escape.systemverilog", "match": "\\\\." }
				]}
			]
		},
		"compiler-directives": {
			"patterns": [
				{ "name": "keyword.control.directive.systemverilog", "match": "`(define|undef|ifdef|ifndef|else|elsif|endif|include|timescale|default_nettype|resetall|celldefine|endcelldefine|unconnected_drive|nounconnected_drive|pragma|line|begin_keywords|end_keywords)\\b" },
				{ "name": "constant.other.preprocessor.systemverilog", "match": "`[a-zA-Z_][a-zA-Z0-9_]*" }
			]
		},
		"system-tasks": {
			"patterns": [
				{ "name": "support.function.system.systemverilog", "match": "\\$[a-zA-Z_][a-zA-Z0-9_$]*" }
			]
		},
		"numbers": {
			"patterns": [
				{ "name": "constant.numeric.sized.systemverilog", "match": "\\b[0-9]*'[sS]?[bBoOdDhH][0-9a-fA-F_xXzZ?]+\\b" },
				{ "name": "constant.numeric.real.systemverilog", "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b" },
				{ "name": "constant.numeric.decimal.systemverilog", "match": "\\b[0-9][0-9_]*\\b" },
				{ "name": "constant.numeric.time.systemverilog", "match": "\\b[0-9]+(fs|ps|ns|us|ms|s)\\b" }
			]
		},
		"operators": {
			"patterns": [
				{ "name": "keyword.operator.assignment.systemverilog", "match": "<=|=>" },
				{ "name": "keyword.operator.comparison.systemverilog", "match": "===|!==|==|!=|>=|<=|>|<" },
				{ "name": "keyword.operator.logical.systemverilog", "match": "&&|\\|\\||!" },
				{ "name": "keyword.operator.bitwise.systemverilog", "match": "&|\\||\\^|~|<<|>>|<<<|>>>" },
				{ "name": "keyword.operator.ternary.systemverilog", "match": "\\?|:" },
				{ "name": "keyword.operator.scope.systemverilog", "match": "::" },
				{ "name": "keyword.operator.inside.systemverilog", "match": "\\binside\\b" }
			]
		},
		"module-declaration": {
			"patterns": [
				{
					"match": "\\b(module|endmodule|macromodule|primitive|endprimitive|program|endprogram|package|endpackage)\\b",
					"name": "keyword.declaration.module.systemverilog"
				},
				{
					"match": "(?<=\\b(?:module|program|package)\\s+)([a-zA-Z_][a-zA-Z0-9_$]*)",
					"captures": { "1": { "name": "entity.name.type.module.systemverilog" } }
				}
			]
		},
		"class-declaration": {
			"patterns": [
				{
					"match": "\\b(class|endclass|extends|implements|virtual\\s+class)\\b",
					"name": "keyword.declaration.class.systemverilog"
				},
				{
					"match": "(?<=\\bclass\\s+)([a-zA-Z_][a-zA-Z0-9_$]*)",
					"captures": { "1": { "name": "entity.name.type.class.systemverilog" } }
				},
				{
					"match": "\\b(interface|endinterface|modport|clocking|endclocking)\\b",
					"name": "keyword.declaration.interface.systemverilog"
				}
			]
		},
		"sv-keywords": {
			"patterns": [
				{ "name": "keyword.control.systemverilog", "match": "\\b(always_comb|always_ff|always_latch|always|initial|final|assign|deassign|force|release|forever|repeat|while|for|foreach|do|if|else|case|casex|casez|unique|unique0|priority|default|endcase|begin|end|fork|join|join_any|join_none|disable|wait|wait_order|return|break|continue|generate|endgenerate|genvar|typedef|enum|struct|union|packed|tagged|void|chandle|string|event|null|this|super|new|const|static|automatic|extern|pure|virtual|local|protected|rand|randc|constraint|solve|before|soft|dist|with|inside|iff|matches|throughout|within|first_match|accept_on|reject_on|sync_accept_on|sync_reject_on|import|export|context|forkjoin|timeprecision|timeunit)\\b" },
				{ "name": "keyword.other.systemverilog", "match": "\\b(assert|assume|cover|expect|restrict|property|endproperty|sequence|endsequence|checker|endchecker|let|bind|alias|wildcard|cross|bins|illegal_bins|ignore_bins|binsof|coverpoint|covergroup|endgroup|option|type_option|sample|randcase|randsequence|production)\\b" }
			]
		},
		"keywords": {
			"patterns": [
				{ "name": "keyword.control.verilog", "match": "\\b(always|initial|assign|deassign|force|release|forever|repeat|while|for|if|else|case|casex|casez|default|endcase|begin|end|fork|join|disable|wait|generate|endgenerate|genvar|specify|endspecify|specparam|defparam|localparam|parameter)\\b" },
				{ "name": "keyword.other.gate.verilog", "match": "\\b(and|nand|or|nor|xor|xnor|not|buf|bufif0|bufif1|notif0|notif1|pullup|pulldown|cmos|nmos|pmos|rcmos|rnmos|rpmos|tran|tranif0|tranif1|rtran|rtranif0|rtranif1)\\b" }
			]
		},
		"sv-storage-types": {
			"patterns": [
				{ "name": "storage.type.systemverilog", "match": "\\b(logic|bit|byte|shortint|int|longint|integer|real|shortreal|realtime|reg|time|signed|unsigned|void|string|chandle|event|type)\\b" },
				{ "name": "storage.type.net.systemverilog", "match": "\\b(wire|tri|tri0|tri1|triand|trior|trireg|wand|wor|supply0|supply1|uwire|interconnect|nettype)\\b" },
				{ "name": "storage.modifier.systemverilog", "match": "\\b(const|static|automatic|extern|pure|virtual|local|protected|rand|randc|ref|var)\\b" }
			]
		},
		"storage-types": {
			"patterns": [
				{ "name": "storage.type.verilog", "match": "\\b(wire|tri|tri0|tri1|triand|trior|trireg|wand|wor|supply0|supply1|reg|integer|real|realtime|time|parameter|localparam|specparam|defparam)\\b" }
			]
		},
		"port-directions": {
			"patterns": [
				{ "name": "storage.modifier.port.systemverilog", "match": "\\b(input|output|inout|ref)\\b" }
			]
		},
		"assertions": {
			"patterns": [
				{ "name": "keyword.assertion.systemverilog", "match": "\\b(assert|assume|cover|expect|restrict)\\b" },
				{ "name": "keyword.assertion.property.systemverilog", "match": "\\b(property|endproperty|sequence|endsequence)\\b" },
				{ "name": "keyword.assertion.operator.systemverilog", "match": "\\|->|\\|=>|##|\\[\\*|\\[=|\\[->|\\bor\\b|\\band\\b|\\bnot\\b|\\bintersect\\b|\\bfirst_match\\b" }
			]
		}
	}
}
