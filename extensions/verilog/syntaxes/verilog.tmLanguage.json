{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Verilog",
	"scopeName": "source.verilog",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#compiler-directives" },
		{ "include": "#system-tasks" },
		{ "include": "#numbers" },
		{ "include": "#operators" },
		{ "include": "#module-declaration" },
		{ "include": "#keywords" },
		{ "include": "#storage-types" },
		{ "include": "#port-directions" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{ "name": "comment.line.double-slash.verilog", "match": "//.*$" },
				{ "name": "comment.block.verilog", "begin": "/\\*", "end": "\\*/" }
			]
		},
		"strings": {
			"patterns": [
				{ "name": "string.quoted.double.verilog", "begin": "\"", "end": "\"", "patterns": [
					{ "name": "constant.character.escape.verilog", "match": "\\\\." }
				]}
			]
		},
		"compiler-directives": {
			"patterns": [
				{ "name": "keyword.control.directive.verilog", "match": "`(define|undef|ifdef|ifndef|else|elsif|endif|include|timescale|default_nettype|resetall|celldefine|endcelldefine|unconnected_drive|nounconnected_drive|pragma|line|begin_keywords|end_keywords)\\b" },
				{ "name": "constant.other.preprocessor.verilog", "match": "`[a-zA-Z_][a-zA-Z0-9_]*" }
			]
		},
		"system-tasks": {
			"patterns": [
				{ "name": "support.function.system.verilog", "match": "\\$[a-zA-Z_][a-zA-Z0-9_$]*" }
			]
		},
		"numbers": {
			"patterns": [
				{ "name": "constant.numeric.sized.verilog", "match": "\\b[0-9]+'[bBoOdDhH][0-9a-fA-F_xXzZ]+\\b" },
				{ "name": "constant.numeric.unsized.verilog", "match": "'[bBoOdDhH][0-9a-fA-F_xXzZ]+\\b" },
				{ "name": "constant.numeric.real.verilog", "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9][0-9_]*)?\\b" }
			]
		},
		"operators": {
			"patterns": [
				{ "name": "keyword.operator.assignment.verilog", "match": "<=|=" },
				{ "name": "keyword.operator.comparison.verilog", "match": "===|!==|==|!=|>=|<=|>|<" },
				{ "name": "keyword.operator.logical.verilog", "match": "&&|\\|\\||!" },
				{ "name": "keyword.operator.bitwise.verilog", "match": "&|\\||\\^|~|<<|>>|<<<|>>>" },
				{ "name": "keyword.operator.ternary.verilog", "match": "\\?|:" },
				{ "name": "keyword.operator.concatenation.verilog", "match": "\\{|\\}" }
			]
		},
		"module-declaration": {
			"patterns": [
				{ "match": "\\b(module|endmodule|macromodule)\\s+([a-zA-Z_][a-zA-Z0-9_$]*)", "captures": {
					"1": { "name": "keyword.declaration.module.verilog" },
					"2": { "name": "entity.name.type.module.verilog" }
				}},
				{ "match": "\\b(function|endfunction|task|endtask)\\s+([a-zA-Z_][a-zA-Z0-9_$]*)?", "captures": {
					"1": { "name": "keyword.declaration.function.verilog" },
					"2": { "name": "entity.name.function.verilog" }
				}}
			]
		},
		"keywords": {
			"patterns": [
				{ "name": "keyword.control.verilog", "match": "\\b(if|else|for|while|repeat|forever|case|casex|casez|default|begin|end|fork|join|disable|wait|force|release|assign|deassign|initial|always|always_comb|always_ff|always_latch|generate|endgenerate|genvar|posedge|negedge|or|and|not|nand|nor|xor|xnor|buf|bufif0|bufif1|notif0|notif1|specify|endspecify|defparam|localparam|parameter|event|return|break|continue)\\b" },
				{ "name": "keyword.other.verilog", "match": "\\b(primitive|endprimitive|table|endtable|pullup|pulldown|cmos|rcmos|nmos|pmos|rnmos|rpmos|tran|rtran|tranif0|tranif1|rtranif0|rtranif1)\\b" }
			]
		},
		"storage-types": {
			"patterns": [
				{ "name": "storage.type.verilog", "match": "\\b(wire|reg|integer|real|realtime|time|tri|tri0|tri1|triand|trior|trireg|wand|wor|supply0|supply1|signed|unsigned|vectored|scalared|automatic|static)\\b" },
				{ "name": "storage.type.net.verilog", "match": "\\b(input|output|inout)\\b" }
			]
		},
		"port-directions": {
			"patterns": [
				{ "name": "storage.modifier.port.verilog", "match": "\\b(input|output|inout)\\b" }
			]
		}
	}
}
